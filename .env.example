# Múi giờ dùng để hiển thị thời gian và tạo chu kỳ ngày/đêm cho dữ liệu mô phỏng.
TZ=Asia/Ho_Chi_Minh

# Container image is immutable. Use a release tag or sha-* tag produced by GitHub Actions.
AQUAOPS_IMAGE=ghcr.io/quynh1808/aquaops
# Dùng đầy đủ SHA của commit đã được GitHub Actions publish thành công.
AQUAOPS_VERSION=sha-replace-with-release-sha

# LAN-only HTTP. Khuyến nghị thay 0.0.0.0 bằng IPv4 tĩnh của card mạng LAN trên Ubuntu,
# ví dụ 192.168.1.20, để ứng dụng không bind vào interface ngoài ý muốn.
AQUAOPS_BIND_ADDRESS=0.0.0.0
AQUAOPS_HTTP_PORT=8080

# Current P03 mode. Valid values: Simulation, EdgeSimulation, Production.
# All modes use MQTT and Modbus; see Docs/OPERATING-MODES.md before changing this value.
AQUAOPS_MODE=EdgeSimulation

# Optional LAN webhook receiver for critical/new alert delivery.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# Optional image pins. Pin digests in a high-control production environment.
MONGO_IMAGE=mongo:8.0
MOSQUITTO_IMAGE=eclipse-mosquitto:2
BUSYBOX_IMAGE=busybox:1.37

# Non-root identity fixed by AquacultureMonitoring.csproj. Do not change only one side.
AQUAOPS_CONTAINER_UID=1654
AQUAOPS_CONTAINER_GID=1654

# Bind đúng IPv4 LAN của Ubuntu để ESP32 kết nối; không port-forward cổng 1883 ra Internet.
MQTT_BIND_ADDRESS=192.168.100.66

# Đổi toàn bộ mật khẩu trước khi dùng ngoài môi trường thử nghiệm.
MONGO_ROOT_USERNAME=aquaops
MONGO_ROOT_PASSWORD='replace-with-a-long-random-root-password'
MONGO_APP_DATABASE=aquaculture_monitoring
MONGO_APP_USERNAME=aquaops_app
MONGO_APP_PASSWORD='replace-with-a-different-long-random-password'

MQTT_USERNAME=aquaops_gateway
MQTT_PASSWORD='replace-with-a-long-random-mqtt-password'

# Tài khoản quản trị chỉ được tạo khi collection users đang rỗng.
AQUAOPS_ADMIN_USERNAME=admin
AQUAOPS_ADMIN_PASSWORD='replace-with-a-long-random-admin-password'
AQUAOPS_ADMIN_DISPLAY_NAME='Quản trị hệ thống'

# ESP32 FX5U simulator defaults. Use a DHCP reservation or fixed IP on the LAN.
FX5U_HOST=192.168.100.81
FX5U_PORT=1502
FX5U_UNIT_ID=1

# Keep commands disabled until PLC/relay mapping, read-back and fail-safe tests pass.
HARDWARE_CONTROL_ENABLED=false

# Only for a USB/RS-485 adapter attached directly to Ubuntu. Prefer /dev/serial/by-id over ttyUSB#.
# COMPOSE_FILE=compose.yaml:compose.hardware.yaml
# MODBUS_RTU_DEVICE=/dev/serial/by-id/usb-your-adapter-id
# DIALOUT_GID=20
