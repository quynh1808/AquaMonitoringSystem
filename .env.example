# Múi giờ dùng để hiển thị thời gian và tạo chu kỳ ngày/đêm cho dữ liệu mô phỏng.
TZ=Asia/Ho_Chi_Minh

# Container image is immutable. Use a release tag or sha-* tag produced by GitHub Actions.
AQUAOPS_IMAGE=ghcr.io/quynh1808/aquaops
# Dùng đầy đủ SHA của commit đã được GitHub Actions publish thành công.
AQUAOPS_VERSION=sha-replace-with-release-sha
# Chỉ ghi hostname, không thêm https:// hoặc dấu / cuối.
AQUAOPS_DOMAIN=aquaops.example.com
# Email thật để nhận thông báo chứng chỉ TLS từ ACME.
ACME_EMAIL=quynh.nm1808@gmail.com

# Optional image pins. Pin digests in a high-control production environment.
MONGO_IMAGE=mongo:8.0
MOSQUITTO_IMAGE=eclipse-mosquitto:2
CADDY_IMAGE=caddy:2-alpine

# Mặc định MQTT chỉ mở trên chính máy chủ để chạy thử an toàn.
# Khi ESP32/gateway trong LAN cần kết nối, đổi thành IP LAN của server hoặc 0.0.0.0,
# đồng thời bật tài khoản/ACL/TLS trong Mosquitto trước khi dùng production.
MQTT_BIND_ADDRESS=127.0.0.1

# Đổi toàn bộ mật khẩu trước khi dùng ngoài môi trường thử nghiệm.
MONGO_ROOT_USERNAME=aquaops
MONGO_ROOT_PASSWORD=Quynh1808
MONGO_APP_DATABASE=aquaculture_monitoring
MONGO_APP_USERNAME=aquaops_app
MONGO_APP_PASSWORD=Quynh1808

MQTT_USERNAME=aquaops_gateway
MQTT_PASSWORD=Quynh1808

# Tài khoản quản trị chỉ được tạo khi collection users đang rỗng.
AQUAOPS_ADMIN_USERNAME=admin
AQUAOPS_ADMIN_PASSWORD=Quynh1808
AQUAOPS_ADMIN_DISPLAY_NAME=Quản trị hệ thống

# Keep real actuator commands disabled until PLC/relay commissioning is complete.
HARDWARE_CONTROL_ENABLED=false
DEVICE_SIMULATION_ENABLED=true

# Only for a USB/RS-485 adapter attached directly to Ubuntu. Prefer /dev/serial/by-id over ttyUSB#.
# COMPOSE_FILE=compose.yaml:compose.hardware.yaml
# MODBUS_RTU_DEVICE=/dev/serial/by-id/usb-your-adapter-id
# DIALOUT_GID=20
