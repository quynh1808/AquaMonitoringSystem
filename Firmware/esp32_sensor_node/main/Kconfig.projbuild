menu "AquaOps sensor node"
    config AQUA_WIFI_SSID
        string "Wi-Fi SSID"
        default "CHANGE_ME"
    config AQUA_WIFI_PASSWORD
        string "Wi-Fi password"
        default "CHANGE_ME"
    config AQUA_MQTT_URI
        string "MQTT broker URI"
        default "mqtt://192.168.100.66:1883"
