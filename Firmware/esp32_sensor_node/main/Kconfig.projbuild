        string "MQTT username"
        default "aquaops_gateway"
    config AQUA_MQTT_PASSWORD
        string "MQTT password"
        default "CHANGE_ME"
    config AQUA_FARM_ID
        string "Farm ID"
        default "farm_main"
    config AQUA_POND_ID
        string "Pond ID"
        default "pond_01"
endmenu
