{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "aquaculture_monitoring",
    "ServerSelectionTimeoutSeconds": 10
  },
  "OperationalMode": {
    "Mode": "Simulation"
  },
  "AlertNotifications": {
    "Enabled": false,
    "WebhookUrl": "",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning"
    }
  },
  "AllowedHosts": "*"
}
