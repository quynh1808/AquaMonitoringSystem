{
  "SensorConnections": {
    "ActiveSources": [
      "simulation"
    ],
    "Mqtt": {
      "Enabled": false,
      "Host": "mosquitto",
      "Port": 1883,
      "ClientId": "aquaops-server",
      "TopicFilter": "aquaculture/+/+/sensors/+/telemetry",
      "Username": "",
      "Password": "",
      "UseTls": false,
      "AllowUntrustedCertificates": false,
      "ReconnectDelaySeconds": 5
    },
    "ModbusTcp": [
      {
        "Id": "plc-zone-a",
        "Enabled": false,
        "Host": "192.168.10.101",
        "Port": 502,
        "PollIntervalMilliseconds": 2000,
        "TimeoutMilliseconds": 3000,
        "Mappings": [
          {
            "SensorId": "sensor_pond_01_dissolvedOxygen",
            "PondId": "pond_01",
            "Metric": "dissolvedOxygen",
            "Unit": "mg/L",
            "UnitId": 1,
            "RegisterAddress": 0,
            "RegisterCount": 2,
            "DataType": "Float32",
            "ByteOrder": "ABCD",
            "Scale": 1.0,
            "Offset": 0.0
          },
          {
            "SensorId": "sensor_pond_01_ph",
            "PondId": "pond_01",
            "Metric": "ph",
            "Unit": "pH",
            "UnitId": 1,
            "RegisterAddress": 2,
            "RegisterCount": 2,
            "DataType": "Float32",
            "ByteOrder": "ABCD",
            "Scale": 1.0,
            "Offset": 0.0
          }
        ]
      }
    ],
    "ModbusRtu": [
      {
        "Id": "rs485-zone-b",
        "Enabled": false,
        "PortName": "/dev/ttyUSB0",
        "BaudRate": 9600,
        "DataBits": 8,
        "Parity": "None",
        "StopBits": "One",
        "PollIntervalMilliseconds": 2000,
        "TimeoutMilliseconds": 3000,
        "Mappings": [
          {
            "SensorId": "sensor_pond_02_temperature",
            "PondId": "pond_02",
            "Metric": "temperature",
            "Unit": "°C",
            "UnitId": 1,
            "RegisterAddress": 0,
            "RegisterCount": 2,
            "DataType": "Float32",
            "ByteOrder": "ABCD",
            "Scale": 1.0,
            "Offset": 0.0
          }
        ]
      }
    ]
  }
}
