@inject SystemConfigurationService Configuration

@if(IsOpen&&Sensor is not null){<div class="modal-layer"><button class="modal-backdrop" @onclick="Close"></button><section class="modal-card compact"><button class="modal-close" @onclick="Close">×</button><div class="modal-heading"><span class="eyebrow">SENSOR LIFECYCLE</span><h2>Thay cảm biến · @Sensor.Name</h2><p>Giữ nguyên SensorId, tạo InstallationId mới để không trộn lịch sử đầu dò.</p></div>
@if(!started){<div class="form-grid"><label class="full">Lý do thay<textarea @bind="reason" rows="3"></textarea></label><label class="check-label full"><input type="checkbox" @bind="nodePowerOff" /> Cần tắt toàn bộ ESP32 trong khi thay</label></div><div class="modal-actions"><button class="button ghost" @onclick="Close">Hủy</button><button class="button danger" @onclick="Begin">Bắt đầu bảo trì</button></div>}
else{<p class="form-notice">Sensor đang Maintenance. Sau khi lắp đầu dò mới, nhập nhận dạng vật lý bên dưới.</p><div class="form-grid"><label>Serial<InputText @bind-Value="serial" /></label><label>Model<InputText @bind-Value="probeModel" /></label><label>Nhà sản xuất<InputText @bind-Value="manufacturer" /></label></div><div class="modal-actions"><button class="button primary" @onclick="Complete">Hoàn tất lắp đặt</button></div>}
@if(!string.IsNullOrWhiteSpace(error)){<p class="auth-error">@error</p>}</section><ConfirmActionDialog @ref="confirmation" /></div>}
@code{[Parameter]public bool IsOpen{get;set;}[Parameter]public EventCallback<bool>IsOpenChanged{get;set;}[Parameter]public SensorDefinition?Sensor{get;set;}private bool started,nodePowerOff;private string reason="",serial="",probeModel="",manufacturer="",error="";private ConfirmActionDialog?confirmation;
private async Task Begin(){var c=await confirmation!.ShowAsync("Bắt đầu thay cảm biến?",$"{Sensor!.Name} sẽ chuyển sang Maintenance.",nodePowerOff?"Toàn bộ node được đánh dấu MaintenanceOffline; cảm biến phụ thuộc không tạo bão cảnh báo.":"Chỉ cảm biến này tạm ngừng.","danger",true,"Bắt đầu");if(!c.Confirmed)return;reason=string.IsNullOrWhiteSpace(c.Reason)?reason:c.Reason;try{await Configuration.BeginSensorReplacementAsync(Sensor.Id,reason,nodePowerOff);started=true;}catch(Exception ex){error=ex.Message;}}
private async Task Complete(){var c=await confirmation!.ShowAsync("Xác nhận đầu dò mới?",$"Tạo InstallationId mới cho {Sensor!.Id}.",$"Serial: {serial}\nModel: {probeModel}\nNhà sản xuất: {manufacturer}","warning",true,"Hoàn tất");if(!c.Confirmed)return;try{await Configuration.CompleteSensorReplacementAsync(Sensor.Id,serial,probeModel,manufacturer,string.IsNullOrWhiteSpace(c.Reason)?reason:c.Reason);await Close();}catch(Exception ex){error=ex.Message;}}
private Task Close()=>IsOpenChanged.InvokeAsync(false);}
