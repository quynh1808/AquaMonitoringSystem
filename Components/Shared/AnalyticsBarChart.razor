<div class="ams-bar-chart" role="img" aria-label="@AriaLabel">
    @if (Points.Count == 0)
    {
        <div class="empty-state compact"><p>Chưa có dữ liệu biểu đồ.</p></div>
    }
    else
    {
        @foreach (var point in Points)
        {
            var percent = MaxValue <= 0 ? 0 : Math.Clamp(point.Value / MaxValue * 100d, 0, 100);
            <div class="ams-bar-item">
                <div class="ams-bar-label"><span>@point.Label</span><strong>@Format(point.Value) @Unit</strong></div>
                <div class="ams-bar-track"><i style="width:@Percent(percent)%"></i></div>
                @if (ShowSecondary && point.SecondaryValue > 0)
                {
                    var secondaryPercent = MaxValue <= 0 ? 0 : Math.Clamp(point.SecondaryValue / MaxValue * 100d, 0, 100);
                    <div class="ams-bar-track secondary"><i style="width:@Percent(secondaryPercent)%"></i></div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<DashboardSeriesPoint> Points { get; set; } = [];
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public int Digits { get; set; }
    [Parameter] public bool ShowSecondary { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Biểu đồ cột";

    private double MaxValue => Points.Count == 0 ? 0 : Points.Max(x => Math.Max(x.Value, ShowSecondary ? x.SecondaryValue : 0));
    private string Format(double value) => value.ToString($"N{Digits}", CultureInfo.GetCultureInfo("vi-VN"));
    private static string Percent(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
