@inject SystemConfigurationService Configuration

@if(IsOpen){<div class="modal-layer"><button class="modal-backdrop" @onclick="Close"></button><section class="modal-card"><button class="modal-close" @onclick="Close">×</button><div class="modal-heading"><span class="eyebrow">POND ALARM POLICY</span><h2>Ngưỡng cảnh báo · @PondName</h2><p>Ngưỡng gắn với ao + metric, nên vẫn giữ nguyên khi thay đầu dò.</p></div>
<div class="responsive-table"><table><thead><tr><th>Metric</th><th>Warning thấp/cao</th><th>Critical thấp/cao</th><th>Hysteresis</th><th>Delay/Cooldown</th><th></th></tr></thead><tbody>@foreach(var rule in rules){<tr><td><strong>@rule.Metric</strong></td><td><InputNumber @bind-Value="rule.WarningLow" /> / <InputNumber @bind-Value="rule.WarningHigh" /></td><td><InputNumber @bind-Value="rule.CriticalLow" /> / <InputNumber @bind-Value="rule.CriticalHigh" /></td><td><InputNumber @bind-Value="rule.Hysteresis" /></td><td><InputNumber @bind-Value="rule.DelaySeconds" /> / <InputNumber @bind-Value="rule.CooldownSeconds" /></td><td><button class="button ghost small" @onclick="()=>Save(rule)">Lưu</button></td></tr>}</tbody></table></div></section><ConfirmActionDialog @ref="confirmation" /></div>}
@code{[Parameter]public bool IsOpen{get;set;}[Parameter]public EventCallback<bool>IsOpenChanged{get;set;}[Parameter]public string PondId{get;set;}="";[Parameter]public string PondName{get;set;}="";[Parameter]public IReadOnlyList<SensorDefinition>Sensors{get;set;}=[];private List<AlarmRule>rules=[];private string loaded="";private ConfirmActionDialog?confirmation;
protected override async Task OnParametersSetAsync(){if(!IsOpen||loaded==$"{IsOpen}:{PondId}")return;loaded=$"{IsOpen}:{PondId}";var existing=await Configuration.GetPondAlarmRulesAsync(PondId);rules=Sensors.Select(x=>x.Metric).Distinct(StringComparer.OrdinalIgnoreCase).Select(metric=>existing.FirstOrDefault(x=>x.Metric==metric)??new AlarmRule{Id=$"{PondId}:{metric}",PondId=PondId,Metric=metric,IsEnabled=true,Hysteresis=.1,DelaySeconds=30,CooldownSeconds=300}).ToList();}
private async Task Save(AlarmRule rule){var c=await confirmation!.ShowAsync("Lưu ngưỡng cảnh báo ao?",$"Cập nhật {rule.Metric} cho {PondName}.",$"Warning: {rule.WarningLow} / {rule.WarningHigh}\nCritical: {rule.CriticalLow} / {rule.CriticalHigh}\nHysteresis {rule.Hysteresis} · Delay {rule.DelaySeconds}s · Cooldown {rule.CooldownSeconds}s","warning",false,"Lưu ngưỡng");if(c.Confirmed)await Configuration.SavePondAlarmRuleAsync(rule);}
private Task Close()=>IsOpenChanged.InvokeAsync(false);}
