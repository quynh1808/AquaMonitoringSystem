@page "/account/change-password"
@attribute [Authorize]
@inject UserAccountService Accounts
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Đổi mật khẩu · AquaOps</PageTitle>

<AuthGate>
    <section class="page-stack account-security-page">
        <header class="page-heading">
            <div>
                <span class="eyebrow">ACCOUNT SECURITY</span>
                <h1>Đổi mật khẩu</h1>
                <p>Xác minh mật khẩu hiện tại trước khi đặt mật khẩu mới cho tài khoản đang đăng nhập.</p>
            </div>
        </header>

        <article class="panel account-security-card">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="notice @(success ? "success" : "danger")" role="status">@message</div>
            }
            <EditForm Model="model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="form-grid">
                    <label>Mật khẩu hiện tại
                        <span class="password-input-wrap">
                            <input type="@(showCurrent ? "text" : "password")" @bind="model.CurrentPassword" autocomplete="current-password" />
                            <button type="button" class="password-toggle" @onclick="() => showCurrent = !showCurrent" aria-label="@(showCurrent ? "Ẩn mật khẩu" : "Hiện mật khẩu")" aria-pressed="@showCurrent"><span aria-hidden="true">@(showCurrent ? "🙈" : "👁")</span></button>
                        </span>
                    </label>
                    <label>Mật khẩu mới
                        <span class="password-input-wrap">
                            <input type="@(showNew ? "text" : "password")" @bind="model.NewPassword" autocomplete="new-password" />
                            <button type="button" class="password-toggle" @onclick="() => showNew = !showNew" aria-label="@(showNew ? "Ẩn mật khẩu" : "Hiện mật khẩu")" aria-pressed="@showNew"><span aria-hidden="true">@(showNew ? "🙈" : "👁")</span></button>
                        </span>
                    </label>
                    <label>Xác nhận mật khẩu mới
                        <span class="password-input-wrap">
                            <input type="@(showConfirm ? "text" : "password")" @bind="model.ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="password-toggle" @onclick="() => showConfirm = !showConfirm" aria-label="@(showConfirm ? "Ẩn mật khẩu" : "Hiện mật khẩu")" aria-pressed="@showConfirm"><span aria-hidden="true">@(showConfirm ? "🙈" : "👁")</span></button>
                        </span>
                    </label>
                </div>
                <p class="helper-text">Mật khẩu phải có ít nhất 12 ký tự và khác mật khẩu hiện tại.</p>
                <button class="button primary" type="submit" disabled="@saving">@(saving ? "Đang cập nhật..." : "Đổi mật khẩu")</button>
            </EditForm>
        </article>
    </section>
</AuthGate>

@code {
    private readonly ChangePasswordModel model = new();
    private bool showCurrent;
    private bool showNew;
    private bool showConfirm;
    private bool saving;
    private bool success;
    private string message = string.Empty;

    private async Task SubmitAsync()
    {
        saving = true;
        success = false;
        message = string.Empty;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authentication.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? throw new InvalidOperationException("Phiên đăng nhập không có định danh tài khoản.");
            await Accounts.ChangePasswordAsync(userId, model.CurrentPassword, model.NewPassword, CancellationToken.None);
            model.Clear();
            success = true;
            message = "Đã đổi mật khẩu. Mật khẩu mới có hiệu lực cho lần đăng nhập tiếp theo.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "Nhập mật khẩu hiện tại.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nhập mật khẩu mới.")]
        [MinLength(12, ErrorMessage = "Mật khẩu mới phải có ít nhất 12 ký tự.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Xác nhận mật khẩu mới.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Xác nhận mật khẩu không khớp.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public void Clear()
        {
            CurrentPassword = string.Empty;
            NewPassword = string.Empty;
            ConfirmPassword = string.Empty;
        }
    }
}
