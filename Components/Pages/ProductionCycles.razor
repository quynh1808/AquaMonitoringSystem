@page "/production-cycles"
@page "/pond/{PondId}/cycles"
@attribute [Authorize]
@inject ProductionCycleService Cycles
@inject FarmStateService State
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Quản lý vụ nuôi · AquaOps</PageTitle>
<section class="page-stack"><header class="page-heading"><div><span class="eyebrow">PRODUCTION EXECUTION</span><h1>Quản lý vụ nuôi</h1><p>Theo dõi từ chuẩn bị ao, thả giống, tăng trưởng đến thu hoạch và kết thúc chu kỳ.</p></div><AuthorizeView Roles="Administrator,FarmManager"><button class="button primary" @onclick="()=>showCreate=!showCreate">＋ Khởi tạo vụ nuôi</button></AuthorizeView></header>
@if(showCreate){<article class="panel"><div class="panel-heading"><div><h2>Khởi tạo chu kỳ mới</h2><p>Một ao chỉ được có một vụ chưa kết thúc.</p></div></div><EditForm Model="request" OnValidSubmit="Create"><DataAnnotationsValidator/><ValidationSummary/><div class="cycle-form-grid"><label>Ao nuôi<select @bind="request.PondId">@foreach(var pond in State.Ponds){<option value="@pond.Id">@pond.Name</option>}</select></label><label>Mã vụ<input @bind="request.Code"/></label><label>Đối tượng nuôi<input @bind="request.Species"/></label><label>Lô giống<input @bind="request.SeedBatch"/></label><label>Ngày chuẩn bị<input type="date" @bind="request.PreparationStartedDate"/></label><label>Ngày thả<input type="date" @bind="request.StockingDate"/></label><label>Số lượng thả<input type="number" @bind="request.InitialQuantity"/></label><label>Khối lượng ban đầu (g)<input type="number" step="0.001" @bind="request.InitialAverageWeightGrams"/></label><label>Mật độ (con/m²)<input type="number" step="0.1" @bind="request.StockingDensityPerM2"/></label><label>Thu hoạch dự kiến<input type="date" @bind="request.ExpectedHarvestDate"/></label><label>Trạng thái<select @bind="request.Status"><option value="preparing">Chuẩn bị</option><option value="stocking">Thả giống</option><option value="growing">Sinh trưởng</option></select></label><label class="full">Ghi chú<textarea @bind="request.Notes"></textarea></label></div><button class="button primary" type="submit">Lưu vụ nuôi</button></EditForm>@if(!string.IsNullOrEmpty(message)){<p>@message</p>}</article>}
<div class="cycle-summary-grid"><div class="summary-tile"><small>VỤ ĐANG HOẠT ĐỘNG</small><strong>@Visible.Count(x=>x.Status!="completed"&&x.Status!="cancelled")</strong><span>@Visible.Count vụ trong bộ lọc</span></div><div class="summary-tile"><small>BIOMASS ƯỚC TÍNH</small><strong>@((Visible.Sum(x=>x.EstimatedBiomassKg)/1000d).ToString("N2",Vi)) t</strong><span>Dựa trên mẫu gần nhất</span></div><div class="summary-tile"><small>THỨC ĂN ĐÃ DÙNG</small><strong>@Visible.Sum(x=>x.TotalFeedKg).ToString("N0",Vi) kg</strong><span>Từ ngày thả</span></div><div class="summary-tile"><small>FCR TRUNG BÌNH</small><strong>@AverageFcr.ToString("N2",Vi)</strong><span>Chỉ các vụ có dữ liệu</span></div></div>
<div class="cycle-grid">@foreach(var cycle in Visible){var pond=State.Ponds.FirstOrDefault(x=>x.Id==cycle.PondId);<a class="cycle-card" href="@($"/production-cycles/{cycle.Id}")"><header><div><h3>@cycle.Code</h3><p>@pond?.Name · @cycle.Species</p></div><span class="cycle-status @cycle.Status">@StatusText(cycle.Status)</span></header><div class="cycle-metrics"><span><small>Ngày nuôi</small><strong>@Age(cycle) ngày</strong></span><span><small>Biomass</small><strong>@cycle.EstimatedBiomassKg.ToString("N0",Vi) kg</strong></span><span><small>Tỷ lệ sống</small><strong>@cycle.EstimatedSurvivalRatePercent.ToString("N1",Vi)%</strong></span><span><small>FCR</small><strong>@cycle.FeedConversionRatio.ToString("N2",Vi)</strong></span></div><div class="cycle-progress"><i style="width:@Progress(cycle)%"></i></div><small>Thu hoạch dự kiến @cycle.ExpectedHarvestDate.ToString("dd/MM/yyyy")</small></a>}</div></section>
@code{[Parameter]public string? PondId{get;set;} private List<ProductionCycle> items=[];private bool showCreate;private string message="";private CreateProductionCycleRequest request=new();private readonly CultureInfo Vi=CultureInfo.GetCultureInfo("vi-VN");private List<ProductionCycle> Visible=>string.IsNullOrWhiteSpace(PondId)?items:items.Where(x=>x.PondId==PondId).ToList();private double AverageFcr=>Visible.Where(x=>x.FeedConversionRatio>0).Select(x=>x.FeedConversionRatio).DefaultIfEmpty().Average();protected override async Task OnInitializedAsync(){var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();items=await Cycles.GetAllAsync(auth.User);request.PondId=PondId??State.Ponds.FirstOrDefault()?.Id??"";var pond=State.Ponds.FirstOrDefault(x=>x.Id==request.PondId);request.Species=pond?.Species??"";request.Code=$"VU-{DateTime.Today:yyyyMMdd}";}private async Task Create(){try{var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();var cycle=await Cycles.CreateAsync(request,auth.User);Navigation.NavigateTo($"/production-cycles/{cycle.Id}");}catch(Exception ex){message=ex.Message;}}private static int Age(ProductionCycle c)=>Math.Max(0,DateOnly.FromDateTime(DateTime.Today).DayNumber-c.StockingDate.DayNumber);private static string StatusText(string s)=>s switch{"preparing"=>"Chuẩn bị","stocking"=>"Thả giống","growing"=>"Sinh trưởng","harvesting"=>"Thu hoạch","completed"=>"Hoàn thành",_=>s};private static string Progress(ProductionCycle c){var total=Math.Max(1,c.ExpectedHarvestDate.DayNumber-c.StockingDate.DayNumber);return Math.Clamp(Age(c)*100d/total,0,100).ToString("0.##",CultureInfo.InvariantCulture);}}
