@page "/admin/settings/connections"
@attribute [Authorize(Roles = "Administrator")]
@inject SystemConfigurationService Configuration
@inject FarmStateService State

<PageTitle>Network & Connections · AquaOps</PageTitle>
<AuthGate>
<section class="page-stack settings-page">
    <header class="page-heading"><div><span class="eyebrow">THIẾT LẬP HỆ THỐNG</span><h1>Network & Connections</h1><p>Quản lý broker và một socket logic cho từng ESP32, Raspberry Pi, STM32 hoặc PLC.</p></div><div class="heading-actions"><button class="button ghost" @onclick="OpenBroker">＋ MQTT Broker</button><button class="button primary" @onclick="OpenSocket">＋ Thêm kết nối</button></div></header>
    <div class="kpi-grid compact-grid">
        <article class="kpi-card blue"><span>◫</span><div><small>Tổng socket</small><strong>@sockets.Count</strong><p>Node đã khai báo</p></div></article>
        <article class="kpi-card green"><span>●</span><div><small>Online/Reachable</small><strong>@sockets.Count(x=>x.RuntimeStatus is "connected" or "reachable")</strong><p>Đang phản hồi</p></div></article>
        <article class="kpi-card amber"><span>↻</span><div><small>Đang Apply</small><strong>@deployments.Count(x=>x.Status is "applying" or "pending-reconnect")</strong><p>Chờ node ACK</p></div></article>
        <article class="kpi-card violet"><span>!</span><div><small>Degraded/Offline</small><strong>@sockets.Count(x=>x.RuntimeStatus is "degraded" or "disconnected")</strong><p>Cần kiểm tra</p></div></article>
    </div>

    <section class="panel"><div class="panel-heading"><div><span class="eyebrow">BROKER PROFILES</span><h2>Hạ tầng MQTT dùng chung</h2></div></div>
        <div class="connection-profile-list">@foreach(var b in brokers){<article><div><strong>@b.Name</strong><small>@b.Host:@b.Port · @(b.UseTls?"TLS":"LAN TCP") · v@b.Version</small></div><span class="status-pill @(b.IsEnabled?"success":"muted")">@(b.IsEnabled?"ENABLE":"DISABLE")</span><button class="button ghost small" @onclick="()=>EditBroker(b)">Chỉnh sửa</button></article>}@if(brokers.Count==0){<p class="empty-inline">Chưa có MQTT broker profile.</p>}</div>
    </section>

    <div class="connection-grid">
    @foreach(var s in sockets)
    {
        var pond=State.Ponds.FirstOrDefault(x=>x.Id==s.PondId);
        <article class="panel connection-card"><header><div><span class="connection-icon">@(s.Transport=="mqtt"?"MQ":"TCP")</span><div><span class="status-pill @StatusClass(s.RuntimeStatus)">@s.RuntimeStatus.ToUpperInvariant()</span><h3>@s.Name</h3><p>@s.NodeType.ToUpperInvariant() · @s.NodeId</p></div></div><span class="health-ring-mini @StatusClass(s.HealthStatus)"></span></header>
            <dl class="device-specs"><div><dt>Ao</dt><dd>@(pond?.Name??s.PondId)</dd></div><div><dt>Transport</dt><dd>@s.Transport.ToUpperInvariant()</dd></div><div><dt>Endpoint</dt><dd>@Endpoint(s)</dd></div><div><dt>Last seen</dt><dd>@(s.LastMessageAtUtc?.ToLocalTime().ToString("dd/MM HH:mm:ss")??"Chưa có")</dd></div><div><dt>Desired / Reported</dt><dd>v@s.DesiredVersion / v@s.ReportedVersion</dd></div><div><dt>Healthy</dt><dd>@s.HealthStatus</dd></div></dl>
            @if(!string.IsNullOrWhiteSpace(s.LastError)){<p class="connection-error">@s.LastError</p>}
            <div class="device-actions"><button class="button ghost small" @onclick="()=>EditSocket(s)">Chỉnh sửa</button><button class="button ghost small" @onclick="()=>TestSocket(s)">Test</button><button class="button ghost small" @onclick="()=>ViewLogs(s.Id)">Log</button><button class="button ghost small" @onclick="()=>RequestRollback(s)">Rollback</button><button class="button primary small" disabled="@(!s.IsEnabled)" @onclick="()=>RequestApply(s)">Apply</button></div>
        </article>
    }
    </div>
    @if(sockets.Count==0){<section class="empty-state panel"><div class="empty-icon">⌁</div><h2>Chưa có kết nối</h2><p>Tạo broker trước, sau đó thêm socket cho ESP32 hoặc PLC.</p></section>}

    @if(selectedLogSocket is not null){<section class="panel"><div class="panel-heading"><div><span class="eyebrow">CONNECTION LOG</span><h2>@sockets.FirstOrDefault(x=>x.Id==selectedLogSocket)?.Name</h2></div><button class="button ghost small" @onclick="()=>selectedLogSocket=null">Đóng</button></div><div class="log-list">@foreach(var l in logs.Where(x=>x.SocketId==selectedLogSocket)){<article class="log-row"><time>@l.TimestampUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")</time><span class="status-pill @l.Level">@l.EventType</span><p>@l.Message</p></article>}</div></section>}
</section>

@if(showBroker){<div class="modal-layer"><button class="modal-backdrop" @onclick="()=>showBroker=false"></button><section class="modal-card compact"><button class="modal-close" @onclick="()=>showBroker=false">×</button><div class="modal-heading"><span class="eyebrow">MQTT INFRASTRUCTURE</span><h2>@(editingBroker?"Chỉnh sửa broker":"Thêm broker")</h2></div><EditForm Model="brokerModel" OnValidSubmit="SaveBroker"><DataAnnotationsValidator/><div class="form-grid"><label>Tên<InputText @bind-Value="brokerModel.Name" /></label><label>Host/IP<InputText @bind-Value="brokerModel.Host" /></label><label>Port<InputNumber @bind-Value="brokerModel.Port" /></label><label>Username<InputText @bind-Value="brokerModel.Username" autocomplete="off" /></label><label>Password mới<InputText @bind-Value="brokerPassword" type="password" autocomplete="new-password" /><small>Để trống để giữ mật khẩu đang mã hóa.</small></label><label>Keep alive (giây)<InputNumber @bind-Value="brokerModel.KeepAliveSeconds" /></label><label class="check-label"><InputCheckbox @bind-Value="brokerModel.UseTls" /> TLS</label><label class="check-label"><InputCheckbox @bind-Value="brokerModel.IsEnabled" /> Enable</label></div>@if(!string.IsNullOrWhiteSpace(formError)){<p class="auth-error">@formError</p>}<div class="modal-actions"><button type="button" class="button ghost" @onclick="()=>showBroker=false">Hủy</button><button type="submit" class="button primary">Lưu</button></div></EditForm></section></div>}

@if(showSocket){<div class="modal-layer"><button class="modal-backdrop" @onclick="()=>showSocket=false"></button><section class="modal-card"><button class="modal-close" @onclick="()=>showSocket=false">×</button><div class="modal-heading"><span class="eyebrow">NODE SOCKET</span><h2>@(editingSocket?"Chỉnh sửa kết nối":"Thêm kết nối")</h2></div><EditForm Model="socketModel" OnValidSubmit="SaveSocket"><DataAnnotationsValidator/><div class="form-grid"><label>Tên socket<InputText @bind-Value="socketModel.Name" /></label><label>Node type<InputSelect @bind-Value="socketModel.NodeType"><option value="esp32">ESP32</option><option value="raspberry-pi">Raspberry Pi</option><option value="stm32">STM32</option><option value="fx5u">Mitsubishi FX5U</option></InputSelect></label><label>Node ID<InputText @bind-Value="socketModel.NodeId" /></label><label>Ao<InputSelect @bind-Value="socketModel.PondId"><option value="">-- Chọn ao --</option>@foreach(var p in State.Ponds){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label>Transport<InputSelect @bind-Value="socketModel.Transport" @bind-Value:after="TransportChanged"><option value="mqtt">MQTT</option><option value="modbus-tcp">Modbus TCP/IP</option></InputSelect></label><label class="check-label"><InputCheckbox @bind-Value="socketModel.IsEnabled" /> Enable socket</label>
            @if(socketModel.Transport=="mqtt"){<label>Expected Client ID<InputText @bind-Value="socketModel.Mqtt!.ExpectedClientId" /><small>Dùng khi provision/đối chiếu; broker ACL mới là lớp xác thực publisher.</small></label><label>Broker profile<InputSelect @bind-Value="socketModel.Mqtt!.BrokerProfileId"><option value="">-- Chọn broker --</option>@foreach(var b in brokers){<option value="@b.Id">@b.Name</option>}</InputSelect></label><label class="full">Topic prefix<input value="@DerivedTopicPrefix(socketModel)" readonly /><small>Server tự suy ra từ PondId và NodeId để ngăn mapping chéo ao.</small></label><label>QoS<InputNumber @bind-Value="socketModel.Mqtt!.Qos" /></label><label>Offline after (giây)<InputNumber @bind-Value="socketModel.Mqtt!.OfflineAfterSeconds" /></label>}
            else{<label>Host/IP<InputText @bind-Value="socketModel.ModbusTcp!.Host" /></label><label>Port<InputNumber @bind-Value="socketModel.ModbusTcp!.Port" /></label><label>Unit ID<InputNumber @bind-Value="socketModel.ModbusTcp!.UnitId" /></label><label>Polling (ms)<InputNumber @bind-Value="socketModel.ModbusTcp!.PollIntervalMilliseconds" /></label><label>Heartbeat<InputText @bind-Value="socketModel.ModbusTcp!.HeartbeatRegister" /></label><label>Config request<InputText @bind-Value="socketModel.ModbusTcp!.ConfigRequestVariable" /></label><label>Apply request<InputText @bind-Value="socketModel.ModbusTcp!.ApplyRequestVariable" /></label><label>Apply ACK<InputText @bind-Value="socketModel.ModbusTcp!.ApplyAcknowledgedVariable" /></label><label>Error bit<InputText @bind-Value="socketModel.ModbusTcp!.ConfigurationErrorVariable" /></label><label>Desired version<InputText @bind-Value="socketModel.ModbusTcp!.DesiredVersionRegister" /></label><label>Applied version<InputText @bind-Value="socketModel.ModbusTcp!.AppliedVersionRegister" /></label><label>Error code<InputText @bind-Value="socketModel.ModbusTcp!.ErrorCodeRegister" /></label>}
            <label class="full">Ghi chú<InputTextArea @bind-Value="socketModel.Notes" rows="3" /></label></div>@if(!string.IsNullOrWhiteSpace(formError)){<p class="auth-error">@formError</p>}<div class="modal-actions"><button type="button" class="button ghost" @onclick="()=>showSocket=false">Hủy</button><button type="submit" class="button primary">Lưu Draft</button></div></EditForm></section></div>}
<ConfirmActionDialog @ref="confirmation" />
</AuthGate>

@code {
    private List<MqttBrokerProfile> brokers=[];private List<NodeSocket>sockets=[];private List<ConfigurationDeployment>deployments=[];private List<ConnectionLogEntry>logs=[];
    private bool showBroker,showSocket,editingBroker,editingSocket;private string? selectedLogSocket;private string brokerPassword=string.Empty,formError=string.Empty;
    private MqttBrokerProfile brokerModel=new();private NodeSocket socketModel=NewSocket();private ConfirmActionDialog?confirmation;
    protected override async Task OnInitializedAsync(){await State.InitializeUserAsync();await Reload();}
    private async Task Reload(){brokers=await Configuration.GetBrokersAsync();sockets=await Configuration.GetSocketsAsync();deployments=await Configuration.GetDeploymentsAsync();logs=await Configuration.GetLogsAsync();}
    private void OpenBroker(){editingBroker=false;brokerModel=new(){IsEnabled=true};brokerPassword="";formError="";showBroker=true;}
    private void EditBroker(MqttBrokerProfile b){editingBroker=true;brokerModel=new(){Id=b.Id,Name=b.Name,Host=b.Host,Port=b.Port,Username=b.Username,ProtectedPassword=b.ProtectedPassword,UseTls=b.UseTls,AllowUntrustedCertificates=b.AllowUntrustedCertificates,KeepAliveSeconds=b.KeepAliveSeconds,IsEnabled=b.IsEnabled,Version=b.Version};brokerPassword="";formError="";showBroker=true;}
    private async Task SaveBroker(){var c=await confirmation!.ShowAsync("Lưu MQTT broker?",$"Broker {brokerModel.Name} tại {brokerModel.Host}:{brokerModel.Port} sẽ được cập nhật.");if(!c.Confirmed)return;try{await Configuration.SaveBrokerAsync(brokerModel,brokerPassword);showBroker=false;await Reload();}catch(Exception ex){formError=ex.Message;}}
    private void OpenSocket(){editingSocket=false;socketModel=NewSocket();socketModel.PondId=State.Ponds.FirstOrDefault()?.Id??"";formError="";showSocket=true;}
    private void EditSocket(NodeSocket s){editingSocket=true;socketModel=new(){Id=s.Id,Name=s.Name,NodeId=s.NodeId,NodeType=s.NodeType,PondId=s.PondId,Transport=s.Transport,IsEnabled=s.IsEnabled,IsArchived=s.IsArchived,RuntimeStatus=s.RuntimeStatus,HealthStatus=s.HealthStatus,LastError=s.LastError,LastConnectedAtUtc=s.LastConnectedAtUtc,LastMessageAtUtc=s.LastMessageAtUtc,ConsecutiveFailures=s.ConsecutiveFailures,LastLatencyMilliseconds=s.LastLatencyMilliseconds,Notes=s.Notes,DesiredVersion=s.DesiredVersion,ReportedVersion=s.ReportedVersion,DocumentVersion=s.DocumentVersion,Mqtt=s.Mqtt is null?null:new(){BrokerProfileId=s.Mqtt.BrokerProfileId,ExpectedClientId=s.Mqtt.ExpectedClientId,TopicPrefix=s.Mqtt.TopicPrefix,Qos=s.Mqtt.Qos,OfflineAfterSeconds=s.Mqtt.OfflineAfterSeconds},ModbusTcp=s.ModbusTcp is null?null:new(){Host=s.ModbusTcp.Host,Port=s.ModbusTcp.Port,UnitId=s.ModbusTcp.UnitId,TimeoutMilliseconds=s.ModbusTcp.TimeoutMilliseconds,PollIntervalMilliseconds=s.ModbusTcp.PollIntervalMilliseconds,HeartbeatRegister=s.ModbusTcp.HeartbeatRegister,ConfigRequestVariable=s.ModbusTcp.ConfigRequestVariable,ApplyRequestVariable=s.ModbusTcp.ApplyRequestVariable,ApplyAcknowledgedVariable=s.ModbusTcp.ApplyAcknowledgedVariable,ConfigurationErrorVariable=s.ModbusTcp.ConfigurationErrorVariable,DesiredVersionRegister=s.ModbusTcp.DesiredVersionRegister,AppliedVersionRegister=s.ModbusTcp.AppliedVersionRegister,ErrorCodeRegister=s.ModbusTcp.ErrorCodeRegister}};formError="";showSocket=true;}
    private void TransportChanged(){if(socketModel.Transport=="mqtt")socketModel.Mqtt??=new();else socketModel.ModbusTcp??=new();}
    private async Task SaveSocket(){var c=await confirmation!.ShowAsync(editingSocket?"Lưu thay đổi socket?":"Thêm socket?",$"{socketModel.Name} kết nối duy nhất tới {socketModel.NodeId} qua {socketModel.Transport}.",Endpoint(socketModel));if(!c.Confirmed)return;try{await Configuration.SaveSocketAsync(socketModel);showSocket=false;await Reload();}catch(Exception ex){formError=ex.Message;}}
    private async Task RequestApply(NodeSocket s){var c=await confirmation!.ShowAsync("Apply cấu hình tới node?",$"Socket {s.Name} sẽ chuyển sang Applying và chỉ thành Applied sau khi node ACK.",$"Desired hiện tại: v{s.DesiredVersion}\nReported: v{s.ReportedVersion}","warning",true,"Apply");if(!c.Confirmed)return;await Configuration.ApplySocketAsync(s.Id,c.Reason);await Reload();}
    private async Task TestSocket(NodeSocket s){var result=await Configuration.TestSocketAsync(s.Id);await confirmation!.ShowAsync("Kết quả kiểm tra endpoint",result,"Test TCP chỉ xác nhận host/port reachable; node health vẫn dựa trên heartbeat/status.");await Reload();}
    private async Task RequestRollback(NodeSocket s){var c=await confirmation!.ShowAsync("Rollback cấu hình socket?",$"Tạo một desired version mới từ cấu hình trước của {s.Name}.","Rollback vẫn chuyển Applying và phải được node ACK; actuator command cũ không được replay.","danger",true,"Rollback");if(!c.Confirmed)return;try{await Configuration.RollbackSocketAsync(s.Id,c.Reason);await Reload();}catch(Exception ex){await confirmation.ShowAsync("Không thể rollback",ex.Message);}}
    private void ViewLogs(string id){selectedLogSocket=id;}
    private static NodeSocket NewSocket()=>new(){Transport="mqtt",NodeType="esp32",IsEnabled=true,Mqtt=new(),ModbusTcp=new()};
    private static string DerivedTopicPrefix(NodeSocket s)=>$"aquaculture/farm_main/{s.PondId}/nodes/{s.NodeId}";
    private static string Endpoint(NodeSocket s)=>s.Transport=="mqtt"?(s.Mqtt?.TopicPrefix??"Chưa tạo topic"):$"{s.ModbusTcp?.Host}:{s.ModbusTcp?.Port}";
    private static string StatusClass(string s)=>s is "connected" or "reachable" or "healthy"?"success":s is "degraded" or "connecting"?"warning":"muted";
}
