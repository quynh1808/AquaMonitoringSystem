@page "/pond/{Id}"
@page "/pond/{Id}/{Section}"
@attribute [Authorize]
@inject FarmStateService State
@inject NavigationManager Navigation
@inject SystemConfigurationService Configuration
@implements IDisposable

<PageTitle>@(Pond?.Name ?? "Ao nuôi") · AquaOps</PageTitle>
<AuthGate>
@if (Pond is null)
{
    <section class="empty-state panel"><div class="empty-icon">?</div><h1>Không tìm thấy ao nuôi</h1><a class="button primary" href="/dashboard">Về Dashboard</a></section>
}
else
{
<section class="page-stack pond-workspace">
    <header class="pond-command-header">
        <div class="pond-command-title"><a href="/dashboard">← Dashboard tổng</a><div><span class="pond-command-icon">≈</span><span><small>WORKSPACE QUẢN LÝ AO</small><h1>@Pond.Name</h1><p>@Pond.Species · @DaysOfCulture ngày nuôi · @Pond.Area.ToString("N0", Vi) m²</p></span></div></div>
        <div class="pond-command-health"><span class="health-ring @HealthClass"><b>@HealthScore</b><small>/100</small></span><div><small>TRẠNG THÁI VẬN HÀNH</small><strong>@HealthLabel</strong><p>Cập nhật @Telemetry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</p></div></div>
    </header>

    <nav class="pond-page-tabs">
        <NavLink href="@($"/pond/{Id}/overview")"><span>◫</span>Tổng quan</NavLink>
        <NavLink href="@($"/pond/{Id}/sensors")"><span>⌁</span>Cảm biến</NavLink>
        <NavLink href="@($"/pond/{Id}/devices")"><span>⚡</span>Điều khiển thiết bị</NavLink>
        <NavLink href="@($"/pond/{Id}/feeding")"><span>◉</span>Cho ăn</NavLink>
        <NavLink href="@($"/pond/{Id}/alerts")"><span>!</span>Cảnh báo @if(PondAlerts.Count>0){<b>@PondAlerts.Count</b>}</NavLink>
    </nav>

    @if (CurrentSection == "overview")
    {
        <div class="metric-grid">@foreach(var sensor in PondSensors.Where(x=>x.IsEnabled)){<SensorMetricCard Metric="@sensor.Metric" Label="@sensor.Name" Icon="@MetricIcon(sensor.Metric)" Value="@MetricValue(sensor.Metric)" />}</div>
        @if(PondSensors.Count==0){<section class="empty-state panel"><div class="empty-icon">⌁</div><h3>Ao chưa có cảm biến</h3><p>Administrator khai báo sensor, socket và channel trước khi node gửi dữ liệu.</p></section>}
        <div class="pond-overview-grid">
            @if(PondSensors.Count>0){<section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">24H TREND</span><h2>Xu hướng @OverviewMetricLabel</h2></div><a href="@($"/pond/{Id}/sensors")">Mở cảm biến →</a></div><TrendChart Points="OverviewTrend" Unit="@OverviewMetricUnit" Digits="@OverviewMetricDigits" /></section>}
            <section class="panel device-quick-panel"><div class="panel-heading"><div><span class="eyebrow">DEVICE STATUS</span><h2>Thiết bị đã khai báo</h2></div><a href="@($"/pond/{Id}/devices")">Quản lý →</a></div>@foreach(var d in PondDevices.Take(4)){<article><span class="device-symbol">@DeviceSymbol(d.Type)</span><div><strong>@d.Name</strong><small>@FarmStateService.GetDeviceTypeLabel(d.Type) · @d.ConfigurationStatus.ToUpperInvariant()</small></div><b class="@(d.Status=="on"?"success-text":"")">@(d.Status=="on"?"ĐANG BẬT":"ĐANG TẮT")</b></article>}@if(PondDevices.Count==0){<div class="empty-state compact"><h3>Chưa có thiết bị</h3><p>Thiết bị chỉ xuất hiện sau khi Administrator khai báo.</p></div>}</section>
        </div>
        <div class="pond-info-strip"><span><small>Ngày thả giống</small><strong>@Pond.StockingDate.ToString("dd/MM/yyyy")</strong></span><span><small>Mật độ</small><strong>@Pond.StockingDensity.ToString("N0", Vi) con/m²</strong></span><span><small>Dự kiến thu hoạch</small><strong>@Pond.EstimatedHarvestDate.ToString("dd/MM/yyyy")</strong></span><span><small>Thiết bị đang bật</small><strong>@PondDevices.Count(d=>d.Status=="on")/@PondDevices.Count</strong></span></div>
    }
    else if (CurrentSection == "sensors")
    {
        <header class="section-page-heading"><div><span class="eyebrow">SENSOR MONITORING</span><h2>Giám sát cảm biến · @Pond.Name</h2><p>Chỉ hiển thị cảm biến đã được admin ánh xạ tới socket và ChannelId thực tế.</p></div><AuthorizeView Roles="Administrator"><div class="heading-actions"><button class="button ghost" @onclick="()=>showAlarmPolicy=true">Ngưỡng cảnh báo ao</button><button class="button primary" @onclick="OpenAddSensor">＋ Thêm cảm biến</button></div></AuthorizeView></header>
        <div class="sensor-admin-grid">
        @foreach(var sensor in PondSensors.Where(x=>!x.IsArchived))
        {
            var health=SensorHealth(sensor.Id);
            <article class="panel sensor-admin-card"><div class="sensor-card-heading"><SensorMetricCard Metric="@sensor.Metric" Label="@sensor.Name" Icon="@MetricIcon(sensor.Metric)" Value="@MetricValue(sensor.Metric)" /><span class="status-pill @SensorStatusClass(sensor)">@sensor.Status.ToUpperInvariant()</span></div><dl class="device-specs"><div><dt>Sensor ID</dt><dd>@sensor.Id</dd></div><div><dt>Node / Channel</dt><dd>@sensor.NodeId / @sensor.ChannelId</dd></div><div><dt>Socket</dt><dd>@sensor.SocketId</dd></div><div><dt>Chu kỳ</dt><dd>@(sensor.PublishIntervalSeconds==0?"Chưa cấu hình":$"{sensor.PublishIntervalSeconds} giây")</dd></div><div><dt>Desired / Reported</dt><dd>v@sensor.DesiredConfigurationVersion / v@sensor.ReportedConfigurationVersion</dd></div><div><dt>Last good</dt><dd>@(health?.LastGoodSampleAtUtc?.ToLocalTime().ToString("dd/MM HH:mm:ss")??sensor.LastSeenAtUtc?.ToLocalTime().ToString("dd/MM HH:mm:ss")??"Chưa có")</dd></div><div><dt>Driver / Bus</dt><dd>@(health is null?"Chưa báo":$"{health.DriverStatus} / {health.BusStatus}")</dd></div><div><dt>Physical limits</dt><dd>@sensor.MinValidValue – @sensor.MaxValidValue @sensor.Unit</dd></div></dl>@if(!string.IsNullOrWhiteSpace(health?.ErrorMessage)){<p class="connection-error">@health.ErrorCode · @health.ErrorMessage</p>}<AuthorizeView Roles="Administrator"><div class="device-actions"><button class="button ghost small" @onclick="()=>OpenEditSensor(sensor)">Chỉnh sửa</button><button class="button ghost small" @onclick="()=>BeginMaintenance(sensor)">Thay cảm biến</button><button class="button danger small" @onclick="()=>RequestRemoveSensor(sensor)">Xóa cảm biến</button></div></AuthorizeView></article>
        }
        </div>
        @if(PondSensors.Count==0){<section class="empty-state panel"><div class="empty-icon">⌁</div><h2>Chưa có cảm biến</h2><p>Nhấn “Thêm cảm biến”; chu kỳ 0 nghĩa là ESP32 chưa đọc hoặc gửi channel đó.</p></section>}
        <div class="two-column-layout">
            @if(PondSensors.Count>0){<section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">HISTORICAL DATA</span><h2>@MetricLabel trong 24 giờ</h2></div><div class="segmented-control">@foreach(var metric in PondMetrics){<button class="@(chartMetric==metric.Id?"active":"")" @onclick="()=>chartMetric=metric.Id">@metric.Short</button>}</div></div><TrendChart Points="Trend" Unit="@MetricUnit" Digits="@MetricDigits" /></section>}
        </div>
    }
    else if (CurrentSection == "devices")
    {
        <header class="section-page-heading"><div><span class="eyebrow">DEVICE CONTROL</span><h2>Điều khiển thiết bị · @Pond.Name</h2><p>Mỗi thao tác chỉ tác động đến thiết bị được gán cho ao này.</p></div><AuthorizeView Roles="Administrator"><button class="button primary" @onclick="()=>showAddDevice=true">＋ Thêm thiết bị</button></AuthorizeView></header>
        <div class="device-grid">@foreach(var d in PondDevices){<article class="device-card @(d.Status=="on"?"is-on":"")"><div class="device-card-top"><span class="device-symbol">@DeviceSymbol(d.Type)</span><div><span class="status-pill @(d.ConfigurationStatus=="applied"?"success":"warning")">@d.ConfigurationStatus.ToUpperInvariant()</span><h3>@d.Name</h3><p>@FarmStateService.GetDeviceTypeLabel(d.Type) · @d.PowerKw.ToString("N1",Vi) kW</p></div></div><dl class="device-specs"><div><dt>Mode reported</dt><dd>@d.ReportedMode</dd></div><div><dt>PLC</dt><dd>@d.ConnectionStatus</dd></div></dl>@if(d.IsLocalOverrideActive){<p class="physical-lock">Physical Override — chỉ giám sát.</p>}<div class="device-control-row"><AuthorizeView Roles="Administrator,FarmManager,Technician"><a class="button primary" href="/devices">Mở bảng điều khiển an toàn</a></AuthorizeView><AuthorizeView Roles="Administrator"><button class="button danger small" @onclick="()=>RequestRemoveDevice(d)">Xóa thiết bị</button></AuthorizeView></div></article>}</div>
        @if(PondDevices.Count==0){<section class="empty-state panel"><div class="empty-icon">⚙</div><h2>Chưa có thiết bị</h2><p>Nhấn “Thêm thiết bị” để khai báo mapping PLC cho ao này.</p></section>}
        <section class="panel automation-panel"><div class="panel-heading"><div><span class="eyebrow">AUTOMATION LOG</span><h2>Nhật ký tự động hóa của ao</h2></div></div>@foreach(var log in State.AutomationLogs.Where(x=>x.PondId==Id).Take(10)){<article class="log-row"><time>@log.Timestamp.ToLocalTime().ToString("dd/MM HH:mm:ss")</time><p>@log.Message</p></article>}</section>
    }
    else if (CurrentSection == "feeding")
    {
        <header class="section-page-heading"><div><span class="eyebrow">FEED MANAGEMENT</span><h2>Quản lý cho ăn · @Pond.Name</h2><p>Ghi nhận riêng lịch sử, khối lượng và người vận hành của từng ao.</p></div></header>
        <div class="two-column-layout feeding-layout"><AuthorizeView Roles="Administrator,FarmManager,Technician" Context="pondFeedAuthorization"><section class="panel form-panel"><div class="panel-heading"><div><span class="eyebrow">NEW FEED LOG</span><h2>Thêm cữ cho ăn</h2></div></div><EditForm Model="feedModel" OnValidSubmit="SubmitFeed"><DataAnnotationsValidator/><label>Loại thức ăn<InputText @bind-Value="feedModel.FeedType" /></label><label>Khối lượng (kg)<InputNumber @bind-Value="feedModel.AmountKg" /></label><label>Ghi chú<InputTextArea @bind-Value="feedModel.Notes" rows="4" /></label><button class="button success full" type="submit">Lưu nhật ký</button></EditForm>@if(!string.IsNullOrWhiteSpace(feedMessage)){<p class="form-notice">@feedMessage</p>}</section></AuthorizeView><section class="panel table-panel"><div class="panel-heading"><div><span class="eyebrow">FEED HISTORY</span><h2>Lịch sử cho ăn</h2></div></div><div class="responsive-table"><table><thead><tr><th>Thời gian</th><th>Loại thức ăn</th><th>Khối lượng</th><th>Kỹ thuật viên</th><th>Ghi chú</th></tr></thead><tbody>@foreach(var log in PondFeedLogs){<tr><td>@log.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@log.FeedType</strong></td><td>@log.AmountKg.ToString("N1",Vi) kg</td><td>@log.Technician</td><td>@log.Notes</td></tr>}</tbody></table></div></section></div>
    }
    else
    {
        <header class="section-page-heading"><div><span class="eyebrow">ALERT MANAGEMENT</span><h2>Cảnh báo · @Pond.Name</h2><p>Chỉ hiển thị sự kiện liên quan đến ao đang quản lý.</p></div></header>
        <section class="panel alert-list-panel"><div class="alert-list">@foreach(var alert in PondAlerts){<article class="alert-item @alert.Severity"><div class="alert-symbol">!</div><div class="alert-body"><div><span class="status-pill @(alert.Severity=="critical"?"danger":"warning")">@FarmStateService.GetMetricLabel(alert.Metric)</span><time>@alert.Timestamp.ToLocalTime().ToString("dd/MM HH:mm:ss")</time></div><h3>@alert.Message</h3><p>Ngưỡng: @alert.Threshold · Giá trị: @alert.Value.ToString("N3",Vi)</p><p><strong>Đề xuất:</strong> @alert.ProposedSolution</p></div><AuthorizeView Roles="Administrator,FarmManager,Technician"><button class="button success" @onclick="async ()=>await State.ResolveAlertAsync(alert.Id)">Đánh dấu đã xử lý</button></AuthorizeView></article>}@if(PondAlerts.Count==0){<div class="empty-state"><div class="empty-icon">✓</div><h3>Ao đang ổn định</h3><p>Không có cảnh báo chưa xử lý.</p></div>}</div></section>
    }
</section>
<AddDeviceModal @bind-IsOpen="showAddDevice" PondId="@Id" PondName="@Pond.Name" />
<AddSensorModal @bind-IsOpen="showAddSensor" PondId="@Id" PondName="@Pond.Name" Existing="@editingSensor" />
<SensorReplacementModal @bind-IsOpen="showReplacement" Sensor="@replacementSensor" />
<PondAlarmPolicyModal @bind-IsOpen="showAlarmPolicy" PondId="@Id" PondName="@Pond.Name" Sensors="@PondSensors" />
<ConfirmActionDialog @ref="confirmation" />
}
</AuthGate>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string? Section { get; set; }
    private readonly CultureInfo Vi=CultureInfo.GetCultureInfo("vi-VN");
    private string CurrentSection => (Section ?? "overview").ToLowerInvariant() is "overview" or "sensors" or "devices" or "feeding" or "alerts" ? (Section ?? "overview").ToLowerInvariant() : "overview";
    private Pond? Pond=>State.Ponds.FirstOrDefault(p=>p.Id==Id); private TelemetryData Telemetry=>State.GetTelemetry(Id);
    private List<Device> PondDevices=>State.Devices.Where(d=>d.PondId==Id&&!d.IsArchived&&!d.IsPendingRemoval).ToList(); private List<SensorDefinition>PondSensors=>State.Sensors.Where(s=>s.PondId==Id&&!s.IsArchived&&!s.IsPendingRemoval).ToList(); private List<AlertItem> PondAlerts=>State.Alerts.Where(a=>a.PondId==Id&&!a.IsResolved).OrderByDescending(a=>a.Timestamp).ToList(); private List<FeedLog> PondFeedLogs=>State.FeedLogs.Where(f=>f.PondId==Id).OrderByDescending(f=>f.Timestamp).ToList();
    private int DaysOfCulture=>Pond is null?0:Math.Max(0,DateOnly.FromDateTime(DateTime.Today).DayNumber-Pond.StockingDate.DayNumber);
    private int HealthScore => State.CalculateHealthScore(Telemetry);
    private string HealthLabel
    {
        get
        {
            var options = State.GetHealthScoreOptions();
            return PondSensors.Count==0?"Chưa thiết lập":HealthScore >= options.StableMinimum ? "Ổn định" : HealthScore >= options.MonitorMinimum ? "Cần theo dõi" : "Cần xử lý";
        }
    }
    private string HealthClass
    {
        get
        {
            var options = State.GetHealthScoreOptions();
            return PondSensors.Count==0?"not-configured":HealthScore >= options.StableMinimum ? "good" : HealthScore >= options.MonitorMinimum ? "medium" : "poor";
        }
    }
    private bool showAddDevice,showAddSensor,showReplacement,showAlarmPolicy; private SensorDefinition?editingSensor,replacementSensor; private List<SensorHealthSnapshot>sensorHealth=[]; private string chartMetric="dissolvedOxygen"; private AddFeedRequest feedModel=new(); private string initializedId=""; private string feedMessage=""; private ConfirmActionDialog?confirmation;
    private static readonly (string Id,string Short,string Label)[] Metrics=[("dissolvedOxygen","DO","Oxy hòa tan"),("ph","pH","Độ pH"),("temperature","Nhiệt","Nhiệt độ"),("salinity","Mặn","Độ mặn"),("ammonia","NH₃","Amoniac"),("waterLevel","Mực nước","Mực nước")];
    private IReadOnlyList<(string Id,string Short,string Label)> PondMetrics=>Metrics.Where(m=>PondSensors.Any(s=>s.Metric==m.Id)).ToList();
    private string OverviewMetricId=>PondMetrics.FirstOrDefault().Id??string.Empty; private string OverviewMetricLabel=>PondMetrics.FirstOrDefault().Label??"cảm biến"; private IReadOnlyList<TrendPoint> OverviewTrend=>string.IsNullOrEmpty(OverviewMetricId)?[]:State.GetTrend(Id,OverviewMetricId); private string OverviewMetricUnit=>string.IsNullOrEmpty(OverviewMetricId)?string.Empty:State.GetThreshold(OverviewMetricId).Unit; private int OverviewMetricDigits=>string.IsNullOrEmpty(OverviewMetricId)?0:State.GetThreshold(OverviewMetricId).DecimalPlaces; private IReadOnlyList<TrendPoint> Trend=>State.GetTrend(Id,chartMetric); private string MetricLabel=>Metrics.FirstOrDefault(x=>x.Id==chartMetric).Label??chartMetric; private string MetricUnit=>State.GetThreshold(chartMetric).Unit; private int MetricDigits=>State.GetThreshold(chartMetric).DecimalPlaces;
    protected override void OnInitialized()=>State.Changed+=Changed;
    protected override async Task OnParametersSetAsync(){if(Pond is null)return;State.SelectPond(Id);if(initializedId!=Id){initializedId=Id;feedModel=new(){PondId=Id,FeedType="Thức ăn tăng trọng cỡ 1,5 mm",AmountKg=20};chartMetric=PondSensors.FirstOrDefault()?.Metric??"dissolvedOxygen";}sensorHealth=await Configuration.GetSensorHealthAsync();}
    private async Task SubmitFeed(){feedModel.PondId=Id;await State.AddFeedLogAsync(feedModel);feedMessage=$"Đã lưu {feedModel.AmountKg:N1} kg lúc {DateTime.Now:HH:mm}.";feedModel=new(){PondId=Id,FeedType=feedModel.FeedType,AmountKg=feedModel.AmountKg};}
    private static string DeviceSymbol(string type)=>type switch{"aerator"=>"◌","auto_feeder"=>"◉","water_pump"=>"↥","light"=>"☼",_=>"≈"};
    private static string MetricIcon(string metric)=>metric switch{"dissolvedOxygen"=>"O₂","ph"=>"pH","temperature"=>"°C","salinity"=>"S","ammonia"=>"N","waterLevel"=>"↕",_=>"⌁"};
    private double MetricValue(string metric)=>metric switch{"dissolvedOxygen"=>Telemetry.DissolvedOxygen,"ph"=>Telemetry.Ph,"temperature"=>Telemetry.Temperature,"salinity"=>Telemetry.Salinity,"ammonia"=>Telemetry.Ammonia,"waterLevel"=>Telemetry.WaterLevel,_=>0};
    private static string SensorStatusClass(SensorDefinition s)=>s.Status=="online"?"success":s.Status is "fault" or "disconnected"?"danger":s.Status=="maintenance"?"warning":"muted";
    private SensorHealthSnapshot? SensorHealth(string sensorId)=>sensorHealth.FirstOrDefault(x=>x.SensorId==sensorId);
    private void OpenAddSensor(){editingSensor=null;showAddSensor=true;}private void OpenEditSensor(SensorDefinition s){editingSensor=s;showAddSensor=true;}private void BeginMaintenance(SensorDefinition s){replacementSensor=s;showReplacement=true;}
    private async Task RequestRemoveSensor(SensorDefinition sensor){var result=await confirmation!.ShowAsync("Xóa cảm biến?",$"{sensor.Name} sẽ biến mất khỏi màn hình vận hành và ESP32 được yêu cầu dừng channel {sensor.ChannelId}.",$"SensorId: {sensor.Id}\nSocket: {sensor.SocketId}\nDữ liệu lịch sử vẫn được giữ.","danger",true,"Xóa cảm biến");if(!result.Confirmed)return;try{await Configuration.RequestSensorRemovalAsync(sensor.Id,result.Reason);}catch(Exception ex){await confirmation.ShowAsync("Không thể xóa cảm biến",ex.Message);}}
    private async Task RequestRemoveDevice(Device device){var result=await confirmation!.ShowAsync("Xóa thiết bị?",$"{device.Name} sẽ bị khóa điều khiển và mapping PLC chỉ được archive sau ACK.",$"Run feedback phải OFF. AUTO policy phải được tắt.\nLịch sử lệnh và audit vẫn được giữ.","danger",true,"Xóa thiết bị");if(!result.Confirmed)return;try{await Configuration.RequestDeviceRemovalAsync(device.Id,result.Reason);}catch(Exception ex){await confirmation.ShowAsync("Không thể xóa thiết bị",ex.Message);}}
    private void Changed()=>InvokeAsync(StateHasChanged); public void Dispose()=>State.Changed-=Changed;
}
