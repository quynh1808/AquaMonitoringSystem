@page "/production-cycles/{CycleId}"
@attribute [Authorize]
@inject ProductionCycleService Cycles
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Chi tiết vụ nuôi · AquaOps</PageTitle>
@if(snapshot is null){<section class="empty-state"><h1>Không tìm thấy vụ nuôi</h1></section>}else{var c=snapshot.Cycle;<section class="page-stack"><header class="page-heading"><div><span class="eyebrow">@c.Code</span><h1>@snapshot.Pond.Name · @c.Species</h1><p>Ngày nuôi thứ @Age(c) · dự kiến thu hoạch @c.ExpectedHarvestDate.ToString("dd/MM/yyyy")</p></div><AuthorizeView Roles="Administrator,FarmManager"><select value="@c.Status" @onchange="ChangeStatus"><option value="preparing">Chuẩn bị</option><option value="stocking">Thả giống</option><option value="growing">Sinh trưởng</option><option value="harvesting">Thu hoạch</option><option value="completed">Hoàn thành</option><option value="cancelled">Hủy</option></select></AuthorizeView></header><div class="cycle-summary-grid"><div class="summary-tile"><small>BIOMASS</small><strong>@c.EstimatedBiomassKg.ToString("N0",Vi) kg</strong><span>@c.LatestAverageWeightGrams.ToString("N2",Vi) g/con</span></div><div class="summary-tile"><small>TỶ LỆ SỐNG</small><strong>@c.EstimatedSurvivalRatePercent.ToString("N1",Vi)%</strong><span>Hao hụt @c.MortalityQuantity.ToString("N0",Vi) con</span></div><div class="summary-tile"><small>THỨC ĂN</small><strong>@c.TotalFeedKg.ToString("N0",Vi) kg</strong><span>FCR @c.FeedConversionRatio.ToString("N2",Vi)</span></div><div class="summary-tile"><small>ĐÃ THU HOẠCH</small><strong>@c.HarvestQuantityKg.ToString("N0",Vi) kg</strong><span>@snapshot.HarvestRecords.Count lần</span></div></div><div class="cycle-detail-grid"><article class="panel"><div class="panel-heading"><div><h2>Lịch sử lấy mẫu</h2><p>Biomass được cập nhật từ mẫu mới nhất.</p></div></div><div class="record-list">@foreach(var x in snapshot.Samples){<div class="record-row"><time>@x.SampledAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</time><span><strong>@x.AverageWeightGrams.ToString("N2",Vi) g/con · @x.EstimatedBiomassKg.ToString("N0",Vi) kg</strong><small>@x.SampleSize mẫu · sống @x.EstimatedSurvivalRatePercent.ToString("N1",Vi)% · @x.Source</small></span><b>@x.SampledBy</b></div>}</div></article><article class="panel"><div class="panel-heading"><div><h2>Thêm bản ghi</h2><p>Lấy mẫu, hao hụt hoặc thu hoạch.</p></div></div><AuthorizeView Roles="Administrator,FarmManager,Technician"><div class="auth-form"><label>Loại bản ghi<select @bind="recordType"><option value="sample">Lấy mẫu</option><option value="mortality">Hao hụt</option><option value="harvest">Thu hoạch</option></select></label>@if(recordType=="sample"){<label>Khối lượng trung bình (g)<input type="number" step="0.01" @bind="sampleWeight"/></label><label>Tỷ lệ sống (%)<input type="number" step="0.1" @bind="survival"/></label><label>Cỡ mẫu<input type="number" @bind="sampleSize"/></label>}else if(recordType=="mortality"){<label>Số lượng hao hụt<input type="number" @bind="mortalityQty"/></label><label>Nguyên nhân nghi ngờ<input @bind="cause"/></label>}else{<label>Khối lượng thu hoạch (kg)<input type="number" step="0.1" @bind="harvestKg"/></label><label>Loại thu hoạch<select @bind="harvestType"><option value="partial">Một phần</option><option value="final">Toàn bộ</option></select></label>}<button class="button primary" @onclick="AddRecord">Lưu bản ghi</button></div></AuthorizeView></article></div></section>}
@code{[Parameter]public string CycleId{get;set;}="";private ProductionCycleSnapshot? snapshot;private readonly CultureInfo Vi=CultureInfo.GetCultureInfo("vi-VN");private string recordType="sample",cause="",harvestType="partial";private double sampleWeight=10,survival=95,harvestKg=100;private int sampleSize=50;private long mortalityQty=10;protected override async Task OnParametersSetAsync(){var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();snapshot=await Cycles.GetSnapshotAsync(CycleId,auth.User);}private static int Age(ProductionCycle c)=>Math.Max(0,DateOnly.FromDateTime(DateTime.Today).DayNumber-c.StockingDate.DayNumber);private async Task ChangeStatus(ChangeEventArgs e){if(e.Value is string value){var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();await Cycles.SetStatusAsync(CycleId,value,auth.User);snapshot=await Cycles.GetSnapshotAsync(CycleId,auth.User);}}private async Task AddRecord(){if(snapshot is null)return;var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();var actor=auth.User.Identity?.Name??"unknown";var c=snapshot.Cycle;if(recordType=="sample"){var alive=c.InitialQuantity*survival/100d;await Cycles.AddSampleAsync(new GrowthSample{CycleId=c.Id,PondId=c.PondId,SampleSize=sampleSize,AverageWeightGrams=sampleWeight,EstimatedSurvivalRatePercent=survival,EstimatedBiomassKg=alive*sampleWeight/1000d,SampledBy=actor,Source="manual"},auth.User);}else if(recordType=="mortality"){await Cycles.AddMortalityAsync(new MortalityRecord{CycleId=c.Id,PondId=c.PondId,Quantity=mortalityQty,SuspectedCause=cause,RecordedBy=actor},auth.User);}else{await Cycles.AddHarvestAsync(new HarvestRecord{CycleId=c.Id,PondId=c.PondId,QuantityKg=harvestKg,HarvestType=harvestType,RecordedBy=actor},auth.User);}snapshot=await Cycles.GetSnapshotAsync(CycleId,auth.User);}}
