@page "/devices"
@attribute [Authorize]
@inject FarmStateService State
@inject SystemConfigurationService Configuration
@implements IDisposable

<PageTitle>Thiết bị · AquaOps</PageTitle>

<AuthGate>
    <section class="page-stack">
        <header class="page-heading">
            <div><span class="eyebrow">ĐIỀU KHIỂN PLC</span><h1>Thiết bị vùng nuôi</h1><p>Ba chế độ AUTO, Remote Manual và Physical Override với read-back từ PLC.</p></div>
            <div class="heading-actions pond-filter">
                <label>Lọc theo ao
                    <select value="@filterPondId" @onchange="ChangeFilter">
                        <option value="all">Tất cả ao</option>
                        @foreach (var pond in State.Ponds)
                        {
                            <option value="@pond.Id">@pond.Name</option>
                        }
                    </select>
                </label>
                <AuthorizeView Roles="Administrator"><button class="button primary" @onclick="OpenAddDevice">＋ Thêm thiết bị</button></AuthorizeView>
            </div>
        </header>

        <div class="kpi-grid compact-grid">
            <article class="kpi-card blue"><span>⚙</span><div><small>Tổng thiết bị</small><strong>@FilteredDevices.Count</strong><p>Trong phạm vi đang lọc</p></div></article>
            <article class="kpi-card green"><span>●</span><div><small>Đang hoạt động</small><strong>@FilteredDevices.Count(d => d.Status == "on")</strong><p>Rơ-le ở trạng thái bật</p></div></article>
            <article class="kpi-card amber"><span>A</span><div><small>Chế độ tự động</small><strong>@FilteredDevices.Count(d => d.Mode == "auto")</strong><p>Cho phép logic tự động hóa</p></div></article>
            <article class="kpi-card violet"><span>kW</span><div><small>Tải điện</small><strong>@FilteredDevices.Where(d => d.Status == "on").Sum(d => d.PowerKw).ToString("N1", CultureInfo.GetCultureInfo("vi-VN"))</strong><p>Công suất tức thời</p></div></article>
        </div>

        <div class="device-grid">
            @foreach (var device in FilteredDevices)
            {
                var pond = State.Ponds.FirstOrDefault(p => p.Id == device.PondId);
                <article class="device-card @(device.Status == "on" ? "is-on" : "")">
                    <div class="device-card-top">
                        <div class="device-symbol">@DeviceSymbol(device.Type)</div>
                        <div><span class="status-pill @(device.Status == "on" ? "success" : "muted")">@(device.Status == "on" ? "ĐANG BẬT" : "ĐANG TẮT")</span><h3>@device.Name</h3><p>@pond?.Name</p></div>
                    </div>
                    <dl class="device-specs">
                        <div><dt>Loại</dt><dd>@FarmStateService.GetDeviceTypeLabel(device.Type)</dd></div>
                        <div><dt>Công suất</dt><dd>@device.PowerKw.ToString("N1", CultureInfo.GetCultureInfo("vi-VN")) kW</dd></div>
                        <div><dt>Chế độ</dt><dd>@(device.Mode == "auto" ? "Tự động" : "Thủ công")</dd></div>
                        <div><dt>PLC reported</dt><dd>@device.ReportedMode</dd></div>
                        <div><dt>Remote allowed</dt><dd>@(device.IsRemoteControlAllowed?"Có":"Không")</dd></div>
                        <div><dt>Commissioning</dt><dd>@device.ConfigurationStatus</dd></div>
                    </dl>
                    @if(device.IsLocalOverrideActive||device.ReportedMode=="local-manual"){<p class="physical-lock">🔒 Physical Override đang hoạt động — web chỉ được giám sát.</p>}
                    <AuthorizeView Roles="Administrator,FarmManager,Technician" Context="deviceOperator"><div class="device-actions">
                        <button class="mode-button @(device.Mode == "auto" ? "auto" : "")" @onclick="()=>RequestMode(device)">@(device.Mode == "auto" ? "AUTO" : "REMOTE MANUAL")</button>
                        <button class="button success" disabled="@((!IsPhysical(device)&&!CanRemote(device))||device.Status=="on")" @onclick='() => RequestCommand(device, "on")'>START</button>
                        <button class="button danger" disabled="@((!IsPhysical(device)&&!CanRemote(device))||device.Status=="off")" @onclick='() => RequestCommand(device, "off")'>STOP</button>
                        <AuthorizeView Roles="Administrator" Context="deviceAdmin"><a class="button ghost small" href="@($"/devices/{device.Id}/automation")">Điều kiện AUTO</a></AuthorizeView>
                        <AuthorizeView Roles="Administrator" Context="deviceEditor"><button class="button ghost small" @onclick="()=>OpenEditDevice(device)">Chỉnh sửa</button></AuthorizeView>
                        <AuthorizeView Roles="Administrator" Context="deviceRemover"><button class="button danger small" @onclick="()=>RequestRemoveDevice(device)">Xóa thiết bị</button></AuthorizeView>
                    </div></AuthorizeView>
                </article>
            }
        </div>

        @if (FilteredDevices.Count == 0)
        {
            <section class="empty-state panel"><div class="empty-icon">⚙</div><h2>Chưa có thiết bị</h2><p>Thiết bị chỉ xuất hiện sau khi Administrator khai báo socket và mapping PLC.</p><AuthorizeView Roles="Administrator"><button class="button primary" @onclick="OpenAddDevice">Thêm thiết bị</button></AuthorizeView></section>
        }
    </section>

    <AddDeviceModal @bind-IsOpen="showAddDevice" PondId="@addDevicePondId" PondName="@AddDevicePondName" Existing="@editingDevice" />
    <ConfirmActionDialog @ref="confirmation" />
</AuthGate>

@code {
    private string filterPondId = "all";
    private string addDevicePondId = string.Empty;
    private bool showAddDevice;
    private Device? editingDevice;
    private ConfirmActionDialog? confirmation;

    private List<Device> FilteredDevices => State.Devices.Where(d => !d.IsArchived && !d.IsPendingRemoval &&
        (filterPondId == "all" || d.PondId == filterPondId)).ToList();
    private string AddDevicePondName => State.Ponds.FirstOrDefault(p => p.Id == addDevicePondId)?.Name ?? "Ao nuôi";

    protected override void OnInitialized()
    {
        addDevicePondId = State.SelectedPondId;
        State.Changed += HandleChanged;
    }

    private void ChangeFilter(ChangeEventArgs args)
    {
        filterPondId = args.Value?.ToString() ?? "all";
        if (filterPondId != "all") addDevicePondId = filterPondId;
    }

    private void OpenAddDevice()
    {
        editingDevice = null;
        addDevicePondId = filterPondId == "all" ? State.SelectedPondId : filterPondId;
        if (string.IsNullOrWhiteSpace(addDevicePondId)) addDevicePondId = State.Ponds.FirstOrDefault()?.Id ?? string.Empty;
        showAddDevice = true;
    }
    private void OpenEditDevice(Device device) { editingDevice = device; addDevicePondId = device.PondId; showAddDevice = true; }

    private static string DeviceSymbol(string type) => type switch
    {
        "aerator" => "◌",
        "auto_feeder" => "◉",
        "water_pump" => "↥",
        "light" => "☼",
        _ => "≈"
    };

    private static bool IsPhysical(Device device)=>device.IsLocalOverrideActive||device.ReportedMode=="local-manual";
    private static bool CanRemote(Device device)=>!IsPhysical(device)&&device.ConfigurationStatus=="applied"&&(device.Mode is "manual" or "remote-manual")&&device.IsRemoteControlAllowed&&device.ConnectionStatus=="online";
    private async Task RequestCommand(Device device,string state)
    {
        if(IsPhysical(device)){await confirmation!.ShowAsync("Không thể điều khiển","Thiết bị đang ở Physical Override; chỉ tủ điện/PLC được quyền điều khiển.");return;}
        var result=await confirmation!.ShowAsync(state=="on"?"START thiết bị?":"STOP thiết bị?",$"Gửi pulse {(state=="on"?device.ManualStartRequestVariable:device.ManualStopRequestVariable)} tới {device.Name}.",$"Socket: {device.SocketId}\nFeedback: {device.RunFeedbackVariable}\nCông suất: {device.PowerKw:N1} kW","danger",true,state=="on"?"START":"STOP");
        if(result.Confirmed)await State.ToggleDeviceAsync(device.Id,result.Reason);
    }
    private async Task RequestMode(Device device)
    {
        if(IsPhysical(device)){await confirmation!.ShowAsync("Không thể đổi mode","Physical Override đang hoạt động tại tủ điện.");return;}
        var target=device.Mode=="auto"?"REMOTE MANUAL":"AUTO";var result=await confirmation!.ShowAsync($"Chuyển sang {target}?",$"Thiết bị {device.Name} sẽ đổi quyền điều khiển.",target=="AUTO"?"Automation policy sẽ được phép phát lệnh khi đủ điều kiện.":"Automation bị suppress; operator có thể START/STOP.","warning",true,"Đổi mode");if(result.Confirmed)await State.ToggleDeviceModeAsync(device.Id,result.Reason);
    }
    private async Task RequestRemoveDevice(Device device)
    {
        var result=await confirmation!.ShowAsync("Xóa thiết bị?",$"{device.Name} sẽ bị khóa và ẩn khỏi vận hành.",$"Chỉ thực hiện khi Run Feedback OFF, PLC online và không còn AUTO policy.\nMapping được archive sau PLC ACK; lịch sử vẫn được giữ.","danger",true,"Xóa thiết bị");
        if(!result.Confirmed)return;
        try{await Configuration.RequestDeviceRemovalAsync(device.Id,result.Reason);}
        catch(Exception ex){await confirmation.ShowAsync("Không thể xóa thiết bị",ex.Message);}
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= HandleChanged;
}
