@page "/admin/settings/general"
@attribute [Authorize(Roles = "Administrator")]
@inject Microsoft.Extensions.Options.IOptionsMonitor<OperationalModeOptions> Mode

<PageTitle>Thiết lập chung · AquaOps</PageTitle>
<AuthGate><section class="page-stack settings-page"><header class="page-heading"><div><span class="eyebrow">THIẾT LẬP HỆ THỐNG</span><h1>Thiết lập chung</h1><p>Thông tin môi trường và nguyên tắc vận hành an toàn của AquaOps.</p></div></header><div class="settings-summary-grid"><article class="panel"><span class="eyebrow">OPERATIONAL MODE</span><h2>@Mode.CurrentValue.Mode</h2><p>Mode triển khai là khóa an toàn cấp môi trường và chỉ thay đổi qua biến môi trường khi deploy. Kết nối node cụ thể được quản lý trong PostgreSQL.</p></article><article class="panel"><span class="eyebrow">ACTUATOR PRIORITY</span><h2>Safety › Local › Remote › Auto</h2><p>Physical Override luôn chặn lệnh web. Command cũ không được replay sau reconnect.</p></article><article class="panel"><span class="eyebrow">SENSOR DEFAULT</span><h2>Interval = 0</h2><p>Cảm biến mới không đọc/gửi dữ liệu cho tới khi cấu hình được node ACK.</p></article></div></section></AuthGate>
